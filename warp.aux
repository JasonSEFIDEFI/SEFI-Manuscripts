\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Stability residual $R(r)=|C(D,\nabla D,\nabla ^2 D,I_a)|$ as a function of radial coordinate $r$. The shaded blue band indicates the stability tolerance ($|R|\le 10^{-3}$), and the green region marks the stability manifold $\Sigma $ where $R(r)\approx 0$. The stable interval is $3\le r\le 7$.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:residual}{{3}{4}{Stability residual $R(r)=|C(D,\nabla D,\nabla ^2 D,I_a)|$ as a function of radial coordinate $r$. The shaded blue band indicates the stability tolerance ($|R|\le 10^{-3}$), and the green region marks the stability manifold $\Sigma $ where $R(r)\approx 0$. The stable interval is $3\le r\le 7$}{figure.3}{}}
